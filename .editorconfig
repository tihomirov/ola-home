root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{c,h,overlay,dts,dtsi}]
indent_style = tab
indent_size = 8

[{Kconfig,Kconfig.*}]
indent_style = tab
indent_size = 8

[*.{yml,yaml,json,md,ts,tsx,js,vue}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2
